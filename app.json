{
  "expo": {
    "name": "GatherGo",
    "slug": "gathergoapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#01082E",
    "icon": "./assets/images/gglogo.png",
    "scheme": "gathergoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gathergo.dev",
      "associatedDomains": [
        "applinks:gathergo.events"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0FF1CF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gathergo.dev",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gathergo.events",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "gathergo.events",
              "pathPrefix": "/carpool"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/gglogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gglogo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#01082E"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Urbanist-Regular.ttf",
            "./assets/fonts/Urbanist-Medium.ttf",
            "./assets/fonts/Urbanist-SemiBold.ttf",
            "./assets/fonts/Urbanist-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Urbanist",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Urbanist-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Urbanist-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Urbanist-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Urbanist-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "946f8fac-e9ff-4515-8898-079f76ff558e"
      }
    }
  }
}
